[TEMPLATE]
# Stratifit Platform environment configuration
#
# This file lists environment variable NAMES only. Values live in real .env
# files that are never committed. Infrastructure credentials must remain
# server-side: never prefix secrets with NEXT_PUBLIC_ and never import them
# into client modules.

# --- Database (Supabase-managed PostgreSQL) ---
# Two-role split (Stage 2.2, decision R1):
#   DATABASE_URL          -> stratifit_runtime (application DML; no DDL, no ownership)
#   DATABASE_MIGRATE_URL  -> stratifit_app (migration/schema-owner role; drizzle-kit only)
# DATABASE_URL=
# DATABASE_MIGRATE_URL=
# DIRECT_URL=

# --- Supabase (public-safe configuration; server secrets stay out of NEXT_PUBLIC_*) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # reserved; NOT used in Stage 2.1/2.3 (audit/storage phases)

# --- Compute (RunPod) — only consumed server-side behind ComputeProvider ---
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=

# --- Storage (Stage 2.5: Supabase Storage Foundation) ---
# STORAGE_PROVIDER: 'local' (dev default) or 'supabase'
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_ROOT=.data/storage
#
# Supabase Storage (only when STORAGE_PROVIDER=supabase):
#   SUPABASE_URL               server-side project URL (fallback: NEXT_PUBLIC_SUPABASE_URL,
#                              which is a PUBLIC project URL, not a credential)
#   SUPABASE_SERVICE_ROLE_KEY  server-only service-role credential (NEVER NEXT_PUBLIC_*)
#   SUPABASE_STORAGE_BUCKET    the single PRIVATE deployment-wide bucket
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=
